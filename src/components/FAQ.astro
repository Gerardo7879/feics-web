---
/**
 * Preguntas frecuentes oficiales con acordeones nativos (details/summary)
 * navegables por teclado y datos estructurados FAQPage.
 */
import { SITE, FORM_ENVIO_TRABAJO } from '../config';
import SectionTitle from './SectionTitle.astro';

const preguntas = [
  {
    pregunta: '¿Tiene costo asistir o participar?',
    respuesta: 'No. El foro es completamente gratuito: no hay cuota de asistencia ni de participación.',
  },
  {
    pregunta: '¿Quién puede enviar trabajos?',
    respuesta:
      'Estudiantes y profesionales de licenciaturas en Medicina, Nutrición, Enfermería, Ciencias Biomédicas, Psicología y CAFYS (Ciencias de la Actividad Física y Salud), entre otras áreas de la salud.',
  },
  {
    pregunta: '¿Cuál es la fecha límite para enviar mi resumen?',
    respuesta: `El ${SITE.abstractDeadline} a las ${SITE.abstractDeadlineTime}, mediante el <a href="${FORM_ENVIO_TRABAJO}" target="_blank" rel="noopener noreferrer" class="font-medium text-gold-dark underline-offset-4 hover:underline">formulario de envío de trabajos</a>.`,
  },
  {
    pregunta: '¿En qué modalidad se presenta?',
    respuesta: 'Cartel científico con defensa oral. Es la única modalidad de presentación.',
  },
  {
    pregunta: '¿Cuánto dura la presentación?',
    respuesta: '6 minutos cronometrados de presentación y 3 minutos de réplica con preguntas del jurado.',
  },
  {
    pregunta: '¿Cuántos autores puede tener un trabajo?',
    respuesta: 'Máximo 5 autores; hasta 4 pueden presentar y defender el cartel.',
  },
  {
    pregunta: '¿Se puede enviar un protocolo en curso?',
    respuesta: 'Sí, se aceptan protocolos de investigación en curso.',
  },
  {
    pregunta: '¿Cómo sé si mi trabajo fue aceptado?',
    respuesta:
      'Se notifica por correo al autor de correspondencia. Todos los trabajos que cumplan con el formato establecido en los lineamientos son aceptados para presentación en cartel científico con defensa oral.',
  },
  {
    pregunta: '¿Qué formato debe tener el resumen?',
    respuesta: 'Documento de Word (.docx), en español, Arial 11, justificado, de 400 a 450 palabras sin contar título, autores y adscripción. Encabezados en negritas: Introducción, Objetivos, Metodología (o Descripción del caso), Resultados, Conclusiones y Referencias.',
  },
  {
    pregunta: '¿Qué medidas debe tener el cartel?',
    respuesta: '90 × 120 cm, orientación vertical, legible a un metro de distancia. Referencias en formato Vancouver.',
  },
  {
    pregunta: '¿Debo permanecer junto a mi cartel?',
    respuesta: 'Sí, al menos un autor debe estar junto al cartel de 11:30 a 13:00 h para la defensa oral ante los evaluadores. El número de mampara se envía por correo al autor de correspondencia.',
  },
  {
    pregunta: '¿Hay premiación?',
    respuesta: 'Se premian los tres primeros lugares generales según la calificación final del jurado.',
  },
  {
    pregunta: '¿Se publican los trabajos?',
    respuesta: 'Los resúmenes se publican como memoria en un número especial de REDICINAySA, Revista de Divulgación Científica de Nutrición Ambiental y Seguridad Alimentaria.',
  },
  {
    pregunta: '¿Puedo usar inteligencia artificial?',
    respuesta: 'El uso de IA en la redacción debe declararse. El plagio o la fabricación de datos descalifica el trabajo de forma inmediata.',
  }
] as const;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((item) => ({
    '@type': 'Question',
    name: item.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: item.respuesta.replace(/<[^>]*>?/gm, '') },
  })),
};
---

<section id="faq" class="scroll-mt-20 py-20 md:py-28">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <SectionTitle eyebrow="Dudas">
      Preguntas <span class="text-gold-dark">frecuentes</span>
    </SectionTitle>

    <div class="mt-14 space-y-4">
      {
        preguntas.map((item) => (
          <details class="group rounded-2xl border border-navy/10 bg-card">
            {/* El padding va en el <summary>, no en el <details>: si no, el
                area tocable son solo los ~24px de la linea de texto y tocar
                el relleno de la tarjeta no abre nada. */}
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 font-semibold text-navy [&::-webkit-details-marker]:hidden">
              {item.pregunta}
              <svg
                class="h-5 w-5 shrink-0 text-gold-dark transition-transform group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <p class="px-6 pb-5 text-sm leading-relaxed text-secondary" set:html={item.respuesta}></p>
          </details>
        ))
      }
    </div>

    <p class="mt-10 text-center text-sm text-secondary">
      ¿Tienes otra duda? Escríbenos a{' '}
      {/* inline-block + py-2 engorda el area tocable de 17px a ~33px sin
          sacar el correo de la frase ni cambiar el tamano de fuente. */}
      <a href={`mailto:${SITE.contactEmail}`} class="inline-block py-2 font-medium text-gold-dark underline-offset-4 hover:underline">
        {SITE.contactEmail}
      </a>
    </p>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
